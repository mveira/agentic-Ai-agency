# Database (Supabase-compatible Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agency_agents

# API
API_PORT=3001
API_HOST=0.0.0.0

# CMS (Strapi)
CMS_PORT=1337
CMS_HOST=0.0.0.0

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dashboard
DASHBOARD_PORT=3000

# LLM Configuration (MOCK for Week 1)
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Telemetry
TELEMETRY_ENABLED=true

# Environment
NODE_ENV=development
